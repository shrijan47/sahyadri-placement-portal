# Supabase Client Configuration (Frontend Safe)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key-here
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key-here

# Server-Side Provisioning Only (Keep in .env.local; Never expose in frontend bundle)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here
